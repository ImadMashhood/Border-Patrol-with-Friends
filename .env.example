# Optional. Copy to .env (Linux launcher sources this file).
# With no key, every case works using authored OFFLINE REHEARSAL dialogue.
# OPENROUTER_API_KEY='your-key'
# OPENROUTER_MODEL='google/gemini-2.5-flash-lite'
# Dialogue uses Flash-Lite by user preference; conversation context fixes remain enabled.
BORDER_MAX_PROVIDER_REQUESTS=500
# Optional model-specific USD rates per million tokens; zero means unconfigured.
MODEL_INPUT_USD_PER_MILLION=0
MODEL_OUTPUT_USD_PER_MILLION=0
# WHISPER_BIN='/absolute/path/whisper-cli'
# WHISPER_MODEL='/absolute/path/ggml-tiny.en.bin'
# PIPER_BIN='/absolute/path/piper'
# PIPER_MODEL='/absolute/path/voice.onnx'
# PIPER_MODEL_ALTERNATE='/absolute/path/alternate-voice.onnx'
# BORDER_PORT=3847

# Resident GPU speech profile is detected after ./scripts/setup-voice.sh
# BORDER_SPEECH_PROFILE=reference
# BORDER_SPEECH_PORT=3848
# BORDER_STT_MODEL=small
# BORDER_STT_DEVICE=cuda
# BORDER_TTS_ENGINE=pocket
# BORDER_POCKET_MODEL=english_7m_2026-10
# More quality: english_18m_2026-10 or english_2026-10; smallest: english_2m_2026-10
# Optional instruction-controlled accents/emotions (slower): BORDER_TTS_ENGINE=qwen
# Alternative fast GPU voice: BORDER_TTS_ENGINE=kokoro
# BORDER_TTS_VOICE=am_michael
# BORDER_TTS_VOICE_ALTERNATE=af_heart
# For CPU Tiny/Piper: BORDER_SPEECH_PROFILE=lightweight
